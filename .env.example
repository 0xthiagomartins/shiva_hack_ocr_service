# OCR: endpoint GLM-OCR na Modal (obrigatório)
MODAL_OCR_URL=https://seu-usuario--glm-ocr-ocr.modal.run
# MODAL_OCR_TIMEOUT=120

# LLM (LiteLLM / OpenAI)
OPENAI_API_KEY=sk-...

# Banco: PostgreSQL (produção) ou SQLite (local). Requer psycopg2-binary para Postgres.
# Postgres: DATABASE_URL=postgresql://user:password@host:5432/database
# SQLite:   DATABASE_URL=sqlite:///./data/receipts.db
DATABASE_URL=

# Opcional: diretório para .toon (debug do texto OCR)
# TOON_DIR=./toon_output
